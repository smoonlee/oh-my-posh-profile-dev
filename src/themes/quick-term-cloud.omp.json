{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "patch_pwsh_bleed": true,
  "palette": {
    "accent": "#d75f00",
    "white": "#ffffff",
    "soft-white": "#f2f3f8",
    "black": "#111111",
    "danger": "#da3633",
    "warning": "#d29922",
    "path": "#0087af",
    "git-clean": "#52c77a",
    "git-modified": "#ffa94d",
    "git-diverged": "#f78c8c",
    "git-ahead": "#66b3ff",
    "git-behind": "#ff9966",
    "copilot": "#8957e5",
    "execution-background": "#e4e4e4",
    "execution-foreground": "#585858"
  },
  "var": {
    "dividerColor": "#d75f00"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "foreground": "p:soft-white",
          "background": "p:accent",
          "template": "  {{ .Icon }}  ",
          "options": {
            "windows": "\ue70f",
            "macos": "\ue711",
            "linux": "\ue712",
            "ubuntu": "\uf31c",
            "debian": "\uf306",
            "fedora": "\uf30a",
            "arch": "\uf303",
            "centos": "\uf304",
            "elementary": "\uf309",
            "gentoo": "\uf30d",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "alpine": "\uf300"
          }
        },
        {
          "type": "text",
          "style": "diamond",
          "foreground": "p:white",
          "background": "p:danger",
          "template": "{{ if .Root }} \uf071 ELEVATED {{ end }}"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:white",
          "background": "p:path",
          "template": " {{ .Path | lower }} ",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "\u2026",
            "folder_separator_icon": " <transparent>\ue0b1</> "
          }
        },
        {
          "type": "git",
          "alias": "git",
          "min_width": 70,
          "style": "diamond",
          "trailing_diamond": "\ue0b4",
          "foreground": "p:black",
          "background": "p:git-clean",
          "background_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:git-diverged{{ else if gt .Ahead 0 }}p:git-ahead{{ else if gt .Behind 0 }}p:git-behind{{ else if or .Working.Changed .Staging.Changed }}p:git-modified{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }} {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ else }} \uf044 0{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ else }} \uf046 0{{ end }} \ueb4a {{ .StashCount }} ",
          "options": {
            "branch_icon": "\uf418 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "min_width": 90,
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "invert_powerline": true,
          "foreground": "p:execution-foreground",
          "background": "p:execution-background",
          "template": " \ueba2 {{ .FormattedMs }} ",
          "options": {
            "style": "austin",
            "always_enabled": true
          }
        },
        {
          "type": "copilot",
          "alias": "copilot",
          "min_width": 140,
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:black",
          "background": "p:copilot",
          "background_templates": [
            "{{ if ge .Premium.Percent 90 }}p:danger{{ else if ge .Premium.Percent 70 }}p:warning{{ end }}"
          ],
          "template": " \uec1e {{ .Premium.Percent.GaugeUsed }} Used: {{ .Premium.Percent }}% ",
          "options": {
            "http_timeout": 1000
          },
          "cache": {
            "duration": "5m",
            "strategy": "session"
          }
        },
        {
          "type": "time",
          "min_width": 80,
          "style": "diamond",
          "invert_powerline": true,
          "foreground": "p:soft-white",
          "background": "p:accent",
          "template": " \uf073 {{ .CurrentDate | date .Format }} ",
          "options": {
            "time_format": "15:04:05"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "template": "\u2570\u2500"
        },
        {
          "type": "kubectl",
          "alias": "kubernetes",
          "min_width": 80,
          "style": "plain",
          "foreground": "p:white",
          "template": " \udb84\udcfe : {{ .Context }}{{ if .Namespace }} :: {{ .Namespace }}{{ end }}"
        },
        {
          "type": "az",
          "alias": "azure-cli",
          "min_width": 90,
          "style": "plain",
          "foreground": "p:white",
          "template": " <{{ .Var.dividerColor }}>||</> \uebd8 : {{ .Name }}",
          "options": {
            "source": "cli"
          }
        },
        {
          "type": "az",
          "alias": "azure-pwsh",
          "min_width": 110,
          "style": "plain",
          "foreground": "p:white",
          "template": " <{{ .Var.dividerColor }}>||</> \ue683 : {{ .Name }}",
          "options": {
            "source": "pwsh"
          }
        },
        {
          "type": "aws",
          "alias": "aws",
          "min_width": 120,
          "style": "plain",
          "foreground": "p:white",
          "template": " <{{ .Var.dividerColor }}>||</> \udb83\ude0f : {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "foreground_templates": [
            "{{ if .Root }}p:danger{{ end }}"
          ],
          "template": "{{ if .Root }}#{{ else }}${{ end }}"
        }
      ]
    }
  ]
}
