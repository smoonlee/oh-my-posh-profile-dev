{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "patch_pwsh_bleed": true,
  "var": {
    "dividerColor": "#d75f00",
    "copilotDetailedMinSpace": 45
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "#f2f3f8",
          "background": "#d75f00",
          "template": "  {{ .Icon }}  ",
          "options": {
            "windows": "\ue70f",
            "macos": "\ue711",
            "linux": "\ue712",
            "ubuntu": "\uf31c",
            "debian": "\uf306",
            "fedora": "\uf30a",
            "arch": "\uf303",
            "centos": "\uf304",
            "elementary": "\uf309",
            "gentoo": "\uf30d",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "alpine": "\uf300"
          }
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "#ffffff",
          "background": "#da3633",
          "template": "{{ if .Root }} \uf071 ELEVATED {{ end }}"
        },
        {
          "type": "path",
          "alias": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " {{ .Path | lower }} ",
          "foreground": "#ffffff",
          "background": "#0087af",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "…",
            "folder_separator_icon": " <transparent>\ue0b1</> "
          }
        },
        {
          "type": "git",
          "alias": "git",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "\ue0b4",
          "foreground": "#000000",
          "background": "#52c77a",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ffa94d{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f78c8c{{ end }}",
            "{{ if gt .Ahead 0 }}#66b3ff{{ end }}",
            "{{ if gt .Behind 0 }}#ff9966{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }} {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} \uf016 {{ .Working.Untracked }} \uf044 {{ add .Working.Added .Working.Modified }} \uf458 {{ .Working.Deleted }}{{ if gt .Working.Unmerged 0 }} \uf071 {{ .Working.Unmerged }}{{ end }} \uf046 {{ add .Staging.Added .Staging.Modified .Staging.Deleted .Staging.Unmerged .Staging.Untracked }} \uf0c7 {{ .StashCount }}",
          "options": {
            "branch_icon": "\ue0a0 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "invert_powerline": true,
          "foreground": "#585858",
          "background": "#e4e4e4",
          "template": " \ueba2 {{ .FormattedMs }} ",
          "options": {
            "style": "austin",
            "always_enabled": true
          }
        },
        {
          "type": "copilot",
          "alias": "copilot",
          "min_width": 40,
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#111111",
          "background": "#8250df",
          "background_templates": [
            "{{ if ge .Premium.Percent 90 }}#da3633{{ end }}",
            "{{ if ge .Premium.Percent 70 }}#d29922{{ end }}"
          ],
          "template": " \uec1e{{ $pathLen := 0 }}{{ if .Segments.path }}{{ $pathLen = len .Segments.path.Text }}{{ end }}{{ $gitLen := 0 }}{{ if .Segments.git }}{{ $gitLen = len .Segments.git.Text }}{{ end }}{{ if ge (sub (sub (int .Env.POSH_TERMINAL_WIDTH) $pathLen) $gitLen) (int .Var.copilotDetailedMinSpace) }}  {{ .Premium.Percent.GaugeUsed }} Used: {{ .Premium.Percent }}%{{ else }}  {{ .Premium.Percent }}%{{ end }} ",
          "options": {
            "http_timeout": 3000
          },
          "cache": {
            "duration": "30s",
            "strategy": "session"
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "",
          "foreground": "#f2f3f8",
          "background": "#d75f00",
          "template": " \uf073 {{ .CurrentDate | date .Format }} ",
          "options": {
            "time_format": "15:04:05"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": []
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "kubectl",
          "alias": "kubernetes",
          "style": "plain",
          "foreground": "#ffffff",
          "template": "╰─ \udb84\udcfe : {{ .Context }}{{ if .Namespace }} :: {{ .Namespace }}{{ end }}",
          "cache": {
            "duration": "30s",
            "strategy": "session"
          }
        },
        {
          "type": "az",
          "alias": "azureCli",
          "style": "plain",
          "foreground": "#ffffff",
          "template": "{{ if not .Segments.kubernetes.Text }}╰─{{ end }} <{{ .Var.dividerColor }}>||</> \uebd8 : {{ .Name }}",
          "cache": {
            "duration": "1m",
            "strategy": "session"
          },
          "options": {
            "source": "cli"
          }
        },
        {
          "type": "az",
          "alias": "azurePwsh",
          "style": "plain",
          "foreground": "#ffffff",
          "template": "{{ if and (not .Segments.kubernetes.Text) (not .Segments.azureCli.Text) }}╰─{{ end }} <{{ .Var.dividerColor }}>||</> \ue683 : {{ .Name }}",
          "cache": {
            "duration": "1m",
            "strategy": "session"
          },
          "options": {
            "source": "pwsh"
          }
        },
        {
          "type": "aws",
          "alias": "aws",
          "style": "plain",
          "foreground": "#ffffff",
          "template": "{{ if and (not .Segments.kubernetes.Text) (not .Segments.azureCli.Text) (not .Segments.azurePwsh.Text) }}╰─{{ end }} <{{ .Var.dividerColor }}>||</> \udb83\ude0f : {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}",
          "cache": {
            "duration": "1m",
            "strategy": "session"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#d75f00",
          "foreground_templates": [
            "{{ if .Root }}#da3633{{ end }}"
          ],
          "template": "{{ if .Root }}#{{ else }}${{ end }}"
        }
      ]
    }
  ]
}
